---
import { getRelativeLocaleUrl } from 'astro:i18n';

import HamburgerMenu from '../components/HamburgerMenu.astro';
import { languages } from '../i18n/ui';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
}

const SITE_URL = 'https://presentation-page-bruno.vercel.app/';

const lang: Lang = Astro.currentLocale === 'es' ? 'es' : 'en';
const t = useTranslations(lang);
const otherLang: Lang = lang === 'en' ? 'es' : 'en';
const otherLangUrl = getRelativeLocaleUrl(otherLang, '/');

const {
  title       = t('meta.title'),
  description = t('meta.description'),
} = Astro.props;

const navLinks = [
  { href: '#about',    label: t('nav.about')    },
  { href: '#skills',   label: t('nav.skills')   },
  { href: '#projects', label: t('nav.projects') },
  { href: '#contact',  label: t('nav.contact')  },
];
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description"  content={description} />
    <meta name="author"       content="Bruno Cesano" />
    <meta name="robots"       content="index, follow" />
    <link rel="canonical"     href={SITE_URL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />

    <!-- Theme color (mobile browser bar) -->
    <meta name="theme-color" content="#0ea5e9" />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={SITE_URL} />
    <meta property="og:site_name"   content="Bruno Cesano — Portfolio" />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={`${SITE_URL}/og-image.png`} />
    <meta property="og:locale"      content={lang === 'es' ? 'es_ES' : 'en_US'} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      /* Scroll-reveal animations — toggled by the IntersectionObserver below.
         Uses @keyframes/animation (not `transition`) so it can't collide with
         the `transition-all` utility used elsewhere for hover effects. */
      @keyframes reveal-fade-up    { from { opacity: 0; transform: translateY(28px); }  to { opacity: 1; transform: none; } }
      @keyframes reveal-fade-left  { from { opacity: 0; transform: translateX(40px); }  to { opacity: 1; transform: none; } }
      @keyframes reveal-fade-right { from { opacity: 0; transform: translateX(-40px); } to { opacity: 1; transform: none; } }
      @keyframes reveal-zoom-in    { from { opacity: 0; transform: scale(0.9); }         to { opacity: 1; transform: none; } }

      [data-animate] { opacity: 0; }
      [data-animate="fade-up"]    { transform: translateY(28px); }
      [data-animate="fade-left"]  { transform: translateX(40px); }
      [data-animate="fade-right"] { transform: translateX(-40px); }
      [data-animate="zoom-in"]    { transform: scale(0.9); }

      [data-animate].is-visible {
        animation-duration: 0.7s;
        animation-timing-function: ease;
        animation-fill-mode: forwards;
      }
      [data-animate="fade-up"].is-visible    { animation-name: reveal-fade-up; }
      [data-animate="fade-left"].is-visible  { animation-name: reveal-fade-left; }
      [data-animate="fade-right"].is-visible { animation-name: reveal-fade-right; }
      [data-animate="zoom-in"].is-visible    { animation-name: reveal-zoom-in; }

      @media (prefers-reduced-motion: reduce) {
        [data-animate] {
          opacity: 1 !important;
          transform: none !important;
          animation: none !important;
        }
      }
    </style>
  </head>

  <body class="bg-white text-slate-800 font-sans antialiased">

    <!-- Navigation -->
    <header class="fixed top-0 inset-x-0 z-50 bg-white/90 backdrop-blur-sm border-b border-primary-100 shadow-sm">
      <nav class="max-w-6xl mx-auto px-4 sm:px-8 flex items-center justify-between h-16">

        <!-- Logo -->
        <a href="#" class="flex items-center gap-2 group">
          <span class="w-8 h-8 rounded-lg bg-primary-500 flex items-center justify-center text-white font-bold text-sm group-hover:bg-primary-600 transition-colors">
            BC
          </span>
        </a>

        <!-- Desktop links — hidden below 900px -->
        <ul class="hidden nav:flex items-center gap-1">
          {navLinks.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="px-3 py-1.5 rounded-md text-sm font-medium text-slate-600 hover:text-primary-600 hover:bg-primary-50 transition-all"
              >
                {label}
              </a>
            </li>
          ))}
          <li>
            <a
              href="#contact"
              class="ml-2 px-4 py-1.5 rounded-full bg-accent-400 text-slate-900 text-sm font-semibold hover:bg-accent-300 transition-colors shadow-sm"
            >
              {t('nav.hireMe')}
            </a>
          </li>
          <li>
            <a
              href={otherLangUrl}
              class="ml-1 px-3 py-1.5 rounded-md text-sm font-medium text-slate-500 border border-slate-200 hover:text-primary-600 hover:border-primary-300 transition-all"
              aria-label={`Switch language to ${languages[otherLang]}`}
            >
              {otherLang.toUpperCase()}
            </a>
          </li>
        </ul>

        <!-- Hamburger — visible below 900px -->
        <HamburgerMenu lang={lang} otherLangUrl={otherLangUrl} />

      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="bg-primary-950 text-primary-300 py-8">
      <div class="max-w-6xl mx-auto px-4 sm:px-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm">
        <p>© 2026 <span class="text-white font-medium">Bruno Cesano</span>. {t('footer.rights')}</p>
      </div>
    </footer>

    <script>
      const animated = document.querySelectorAll('[data-animate]');
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Once the reveal animation finishes, drop the `data-animate` attribute
      // so no `[data-animate]` rule targets the element anymore. Otherwise
      // `animation-fill-mode: forwards` keeps pinning `transform`/`opacity`
      // forever, permanently blocking hover transitions (e.g. card
      // lift-on-hover) that also animate those same properties.
      const releaseAnimation = (el: Element) => {
        el.addEventListener('animationend', () => {
          el.removeAttribute('data-animate');
        }, { once: true });
      };

      if (!prefersReduced && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                releaseAnimation(entry.target);
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -60px 0px' }
        );

        animated.forEach((el) => observer.observe(el));
      } else {
        animated.forEach((el) => el.classList.add('is-visible'));
      }
    </script>

  </body>
</html>
