---
import { useTranslations, type Lang } from '../i18n/utils';

const lang: Lang = Astro.currentLocale === 'es' ? 'es' : 'en';
const t = useTranslations(lang);

type Level = 'Basic' | 'Intermediate' | 'Advanced';

const levelConfig: Record<Level, { width: string; bar: string; badge: string; label: string }> = {
  Basic:        { width: '33%',  bar: 'from-slate-300 to-slate-400',       badge: 'bg-slate-100 text-slate-500',      label: t('skills.level.basic') },
  Intermediate: { width: '66%',  bar: 'from-primary-300 to-primary-500',   badge: 'bg-primary-100 text-primary-700', label: t('skills.level.intermediate') },
  Advanced:     { width: '100%', bar: 'from-primary-500 to-accent-500',    badge: 'bg-accent-300/40 text-yellow-700', label: t('skills.level.advanced') },
};

const skillGroups: { category: string; icon: string; skills: { name: string; level: Level }[] }[] = [
  {
    category: t('skills.group.frontend'),
    icon: '🎨',
    skills: [
      { name: 'HTML5',        level: 'Advanced'     },
      { name: 'CSS3',         level: 'Advanced'     },
      { name: 'JavaScript',   level: 'Advanced'     },
      { name: 'TypeScript',   level: 'Advanced' },
      { name: 'React',        level: 'Advanced' },
      { name: 'Astro',        level: 'Intermediate' },
      { name: 'Tailwind CSS', level: 'Advanced'     },
    ],
  },
  {
    category: t('skills.group.backend'),
    icon: '⚙️',
    skills: [
      { name: 'Node.js',   level: 'Intermediate' },
      { name: 'Python',    level: 'Advanced' },
      { name: 'REST APIs', level: 'Advanced' },
      { name: 'SQL',       level: 'Intermediate' },
      { name: 'Express.js', level: 'Intermediate'}
    ],
  },
  {
    category: t('skills.group.tools'),
    icon: '🛠️',
    skills: [
      { name: 'Git',     level: 'Advanced'     },
      { name: 'GitHub',  level: 'Advanced'     },
      { name: 'VS Code', level: 'Advanced'     },
      { name: 'Docker',  level: 'Basic'        },
      { name: 'Vercel',  level: 'Intermediate' },
      { name: 'AWS',  level: 'Basic' },
      { name: 'Heroku',  level: 'Intermediate' }
    ],
  },
];
---

<section id="skills" class="py-24 bg-primary-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-8">

    <!-- Section header -->
    <div class="text-center mb-11">
      <span class="text-primary-500 font-semibold text-sm uppercase tracking-widest">{t('skills.eyebrow')}</span>
      <h2 class="text-4xl sm:text-5xl font-extrabold text-slate-900 mt-2">{t('skills.heading')}</h2>
      <div class="mt-4 mx-auto w-16 h-1 bg-accent-400 rounded-full"></div>
    </div>

    <p class="text-center w-full max-w-[1020px] text-lg mx-auto text-slate-600">
      {t('skills.paragraph1')}
    </p>
    <p class="text-center w-full max-w-[1020px] text-lg mt-3 mb-8 mx-auto text-slate-600">
      {t('skills.paragraph2')}
    </p>

    <!-- Skill groups grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
      {skillGroups.map((group, i) => (
        <div
          class="bg-white rounded-3xl p-6 shadow-sm border border-primary-100 hover:shadow-md hover:border-primary-200 transition-all"
          data-animate="fade-up"
          style={`animation-delay: ${i * 120}ms`}
        >
          <div class="flex items-center gap-3 mb-6">
            <span class="text-2xl">{group.icon}</span>
            <h3 class="font-bold text-slate-800 text-lg">{group.category}</h3>
          </div>
          <div class="space-y-4">
            {group.skills.map((skill) => {
              const cfg = levelConfig[skill.level];
              return (
                <div>
                  <div class="flex justify-between items-center mb-1.5">
                    <span class="font-medium text-slate-700 text-sm">{skill.name}</span>
                    <span class={`text-xs font-semibold px-2 py-0.5 rounded-full ${cfg.badge}`}>
                      {cfg.label}
                    </span>
                  </div>
                  <div class="h-1.5 bg-primary-100 rounded-full overflow-hidden">
                    <div
                      class={`h-full bg-gradient-to-r ${cfg.bar} rounded-full`}
                      style={`width: ${cfg.width}`}
                    ></div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
